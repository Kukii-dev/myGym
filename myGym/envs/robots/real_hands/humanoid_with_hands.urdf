    <joint name="r_index_MCP" type="fixed">
        <parent link="r_index0"/>
        <child link="r_index1"/>
        <origin xyz="0 -0.018 0" rpy="0 0 0"/>
    </joint>

    <link name="r_index2">
        <inertial>
            <origin xyz="-0.001 -0.013 0.001" rpy="0 0 0"/>
            <mass value="0.00345"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
