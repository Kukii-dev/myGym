        <child link="r_wristz"/>
        <origin xyz="0.0002 -0.03 -0.002" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-2.0" upper="2.0" effort="20" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.0001"/>
    </joint>

    <!-- ========== RIGHT PALM ========== -->

