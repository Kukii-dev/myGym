<?xml version="1.0" ?>
<robot name="humanoid_with_hands_fixed">

    <!-- ========== TORSO AND BASE ========== -->
    <link name="torso">
        <inertial>
            <origin xyz="-0.01 0.0 -0.14" rpy="0 0 0"/>
            <mass value="16.74888"/>
            <inertia ixx="0.54992" ixy="0" ixz="0" iyy="0.47455" iyz="0" izz="0.21048"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.14" radius="0.09"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.14" radius="0.09"/>
            </geometry>
            <material name="shirt">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-0.01 0 -0.14" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.12" radius="0.08"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.01 0 -0.14" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.12" radius="0.08"/>
            </geometry>
            <material name="shirt"/>
        </visual>
    </link>

    <link name="head">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="4.0"/>
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.11"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.11"/>
            </geometry>
            <material name="skin">
                <color rgba="0.9 0.75 0.65 1"/>
            </material>
        </visual>
    </link>

    <joint name="torso_to_head" type="fixed">
        <parent link="torso"/>
        <child link="head"/>
        <origin xyz="0 0 0.21" rpy="0 0 0"/>
    </joint>

    <link name="lwaist">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="4.5574"/>
            <inertia ixx="0.0395" ixy="0" ixz="0" iyy="0.01944" iyz="0" izz="0.0395"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.12" radius="0.08"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.12" radius="0.08"/>
            </geometry>
            <material name="shirt">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="torso_to_lwaist" type="fixed">
        <parent link="torso"/>
        <child link="lwaist"/>
        <origin xyz="-0.01 0 -0.31" rpy="0 -0.004 0"/>
    </joint>

    <link name="pelvis">
        <inertial>
            <origin xyz="-0.02 0 0" rpy="0 0 0"/>
            <mass value="8.58702"/>
            <inertia ixx="0.11135" ixy="0" ixz="0" iyy="0.05725" iyz="0" izz="0.11135"/>
        </inertial>
        <collision>
            <origin xyz="-0.02 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.14" radius="0.10"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="-0.02 0 0" rpy="0 -1.5708 0"/>
            <geometry>
                <capsule length="0.14" radius="0.10"/>
            </geometry>
            <material name="shirt">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
    </link>

    <joint name="lwaist_to_pelvis" type="fixed">
        <parent link="lwaist"/>
        <child link="pelvis"/>
        <origin xyz="0.0152 0 -0.185" rpy="0 -0.004 0"/>
    </joint>

    <!-- ========== RIGHT ARM ========== -->

    <link name="r_shoulder_base"/>

    <joint name="r_shoulder_pan" type="revolute">
        <parent link="torso"/>
        <child link="r_shoulder_base"/>
        <origin xyz="-0.20 -0.02 -0.06" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.57" upper="2.0" effort="50" velocity="2.0"/>
        <dynamics damping="1.0" friction="0.0001"/>
    </joint>

    <link name="r_shoulder_lift"/>

    <joint name="r_shoulder_lift" type="revolute">
        <parent link="r_shoulder_base"/>
        <child link="r_shoulder_lift"/>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0" upper="1.57" effort="50" velocity="2.0"/>
        <dynamics damping="1.0" friction="0.0001"/>
    </joint>

    <link name="r_upper_arm">
        <inertial>
            <origin xyz="0 0 -0.115" rpy="0 0 0"/>
            <mass value="1.05512"/>
            <inertia ixx="0.00821" ixy="0" ixz="0" iyy="0.00821" iyz="0" izz="0.00086"/>
        </inertial>
        <collision>
            <origin xyz="0 0 -0.115" rpy="0 0 0"/>
            <geometry>
                <capsule length="0.23" radius="0.035"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 -0.115" rpy="0 0 0"/>
            <geometry>
                <capsule length="0.23" radius="0.035"/>
            </geometry>
            <material name="skin">
                <color rgba="0.9 0.75 0.65 1"/>
            </material>
        </visual>
    </link>

    <joint name="r_arm_roll" type="revolute">
        <parent link="r_shoulder_lift"/>
        <child link="r_upper_arm"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="50" velocity="2.0"/>
        <dynamics damping="1.0" friction="0.0001"/>
    </joint>

    <link name="r_elbow_base"/>

    <joint name="r_elbow_flex" type="revolute">
        <parent link="r_upper_arm"/>
        <child link="r_elbow_base"/>
        <origin xyz="0 0 -0.23" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-2.8" upper="2.8" effort="50" velocity="2.0"/>
        <dynamics damping="1.0" friction="0.0001"/>
    </joint>

    <link name="r_forearm">
        <inertial>
            <origin xyz="0 -0.115 0" rpy="0 0 0"/>
            <mass value="1.05512"/>
            <inertia ixx="0.00821" ixy="0" ixz="0" iyy="0.00821" iyz="0" izz="0.00086"/>
        </inertial>
        <collision>
            <origin xyz="0 -0.115 0" rpy="-1.5708 0 0"/>
            <geometry>
                <capsule length="0.23" radius="0.035"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0 -0.115 0" rpy="-1.5708 0 0"/>
            <geometry>
                <capsule length="0.23" radius="0.035"/>
            </geometry>
            <material name="skin"/>
        </visual>
    </link>

    <joint name="r_elbow_roll" type="revolute">
        <parent link="r_elbow_base"/>
        <child link="r_forearm"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="30" velocity="2.0"/>
        <dynamics damping="1.0" friction="0.0001"/>
    </joint>

    <!-- ========== RIGHT WRIST ========== -->

    <link name="r_wristy">
        <inertial>
            <origin xyz="0 -0.022 0" rpy="0 0 0"/>
            <mass value="0.02729"/>
            <inertia ixx="0.00011" ixy="0" ixz="0" iyy="0.00010" iyz="0" izz="0.00010"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <mesh filename="mesh/right/wristy.stl" scale="1 1 1"/> </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <mesh filename="mesh/right/wristy.stl" scale="1 1 1"/> </geometry>
            <material name="skin"/>
        </visual>
    </link>

    <joint name="r_wrist_PRO" type="revolute">
        <parent link="r_forearm"/>
        <child link="r_wristy"/>
        <origin xyz="0 -0.23 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14" upper="3.14" effort="20" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.0001"/>
    </joint>

    <link name="r_wristx">
        <inertial>
            <origin xyz="0.001 -0.01 -0.003" rpy="0 0 0"/>
            <mass value="0.01069"/>
            <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <mesh filename="mesh/right/wristx.stl" scale="1 1 1"/> </geometry>
        </collision>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <mesh filename="mesh/right/wristx.stl" scale="1 1 1"/> </geometry>
            <material name="skin"/>
        </visual>
    </link>

    <joint name="r_wrist_UDEV" type="revolute">
        <parent link="r_wristy"/>
        <child link="r_wristx"/>
        <origin xyz="0 -0.048 0.002" rpy="0 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.0001"/>
    </joint>

    <link name="r_wristz">
        <inertial>
            <origin xyz="0.001 -0.001 0.0005" rpy="0 0 0"/>
            <mass value="0.00602"/>
            <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry> <mesh filename="mesh/right/wristz.stl" scale="1 1 1"/> </geometry>
