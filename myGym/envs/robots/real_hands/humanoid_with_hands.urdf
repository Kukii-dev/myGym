            <geometry>
                <mesh filename="mesh/right/index0.stl" scale="1 1 1"/>
            </geometry>
            <material name="skin"/>
        </visual>
    </link>

    <joint name="r_index_ABD" type="fixed">
        <parent link="r_palm"/>
        <child link="r_index0"/>
        <origin xyz="0.01 -0.066 0.001" rpy="0 0.175 0"/>
    </joint>

    <link name="r_index1">
        <inertial>
            <origin xyz="0 -0.021 0.001" rpy="0 0 0"/>
            <mass value="0.00478"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
