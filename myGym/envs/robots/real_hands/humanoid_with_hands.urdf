    </joint>

    <link name="gripper">
        <inertial>
            <origin xyz="0 -0.013 0.001" rpy="0 0 0"/>
            <mass value="0.00274"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00000"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
