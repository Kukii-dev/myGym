    <link name="l_shoulder_lift"/>

    <joint name="l_shoulder_lift" type="fixed">
        <parent link="l_shoulder_base"/>
        <child link="l_shoulder_lift"/>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
    </joint>

    <link name="l_upper_arm">
