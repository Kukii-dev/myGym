    <!-- ========== RIGHT INDEX FINGER ========== -->

    <link name="r_index0">
        <inertial>
            <origin xyz="0 -0.005 0" rpy="0 0 0"/>
            <mass value="0.00296"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
