    <!-- ========== LEFT ARM (FIXED - VISUAL ONLY) ========== -->

    <link name="l_shoulder_base"/>

    <joint name="l_shoulder_pan" type="fixed">
        <parent link="torso"/>
        <child link="l_shoulder_base"/>
